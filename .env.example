# --- Database ---
DATABASE_URL=postgresql+psycopg://jobs:jobs@localhost:5432/jobs

# --- LLM provider: openai | gemini | fake ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Must match the pgvector column width in the migration (see README before changing)
EMBEDDING_DIM=768

# --- Adzuna ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# --- Tuning ---
API_CACHE_TTL_HOURS=6
SHORTLIST_SIZE=25
STALE_JOB_DAYS=14
